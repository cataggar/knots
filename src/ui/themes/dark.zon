.{
    .primary = .{ .hex = "#6382ee" },
    .secondary = .{ .hex = "#7763cc" },
    .success = .{ .hex = "#42b080" },
    .info = .{ .hex = "#42a5dc" },
    .warning = .{ .hex = "#eeb333" },
    .@"error" = .{ .hex = "#dc4d4d" },
    .bg = .{ .hex = "#121214" },
    .muted = .{ .hex = "#1e1e21" },
    .elevated = .{ .hex = "#1e1e21" },
    .accented = .{ .hex = "#ededf2" },
    .inverted = .{ .hex = "#121214" },
    .text = .{ .hex = "#eaeaed" },
    .highlighted = .{ .hex = "#ffffff" },
    .toned = .{ .hex = "#38383d" },
    .dimmed = .{ .hex = "#5c5c63" },
    .radius = 6,
    .scrollbar_thickness = 8,
    .scrollbar_min_thumb = 24,
    .scrollbar_track_color = .{ .hex = "#1e1e2180" },
